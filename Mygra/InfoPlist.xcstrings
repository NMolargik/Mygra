    "NSHealthShareUsageDescription" : {
      "comment" : "Permission prompt shown when requesting read access to HealthKit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygra reads your health data to track potential migraine triggers like hydration and sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygra lee tus datos de salud para detectar posibles desencadenantes de migraña, como la hidratación y el sueño."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygra lit vos données de santé pour suivre les déclencheurs potentiels de migraine comme l'hydratation et le sommeil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygraは、水分補給や睡眠など、片頭痛の潜在的な誘因を追跡するためにヘルスデータを読み取ります。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Permission prompt shown when requesting write access to HealthKit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygra saves your water intake, calorie consumption, caffeine, and sleep data to HealthKit for better tracking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygra guarda en HealthKit tus datos de consumo de agua, calorías, cafeína y sueño para un mejor seguimiento."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygra enregistre dans HealthKit vos données de consommation d'eau, de calories, de caféine et de sommeil pour un meilleur suivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygraは、より良い記録のために、水分摂取量、カロリー、カフェイン、睡眠のデータをHealthKitに保存します。"
          }
        }
      }
    },
