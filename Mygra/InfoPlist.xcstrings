    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Permission prompt shown when requesting location access.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to proactively warn of potential environmental triggers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se usa para avisarte de forma proactiva sobre posibles desencadenantes ambientales."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position est utilisée pour vous avertir de façon proactive des déclencheurs environnementaux potentiels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地は、環境的な誘因を事前に警告するために使用されます。"
          }
        }
      }
    },
